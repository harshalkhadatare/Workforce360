[Unit]
Description=Vision Infra HR Portal (Gunicorn)
After=network.target postgresql.service

[Service]
User=vision_hrms
Group=vision_hrms
WorkingDirectory=/srv/vision_hrms
EnvironmentFile=/etc/vision_hrms/env
ExecStart=/srv/vision_hrms/.venv/bin/gunicorn -c deploy/gunicorn.conf.py config.wsgi:application
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/vision_hrms

[Install]
WantedBy=multi-user.target

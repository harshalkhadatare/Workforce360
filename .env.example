# Copy to .env (development) or provide via your process manager (production).
# NEVER commit real values. .env is listed in .gitignore.

# --- Django -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=hr.your-company.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://hr.your-company.example
PORTAL_BASE_URL=https://hr.your-company.example
COMPANY_NAME=Vision Infra Equipment Solutions Ltd.
COMPANY_SHORT_NAME=Vision Infra
TIME_ZONE=Asia/Kolkata

# --- PostgreSQL (use a least-privilege application role) -----------------------
DB_ENGINE=postgresql
DB_NAME=vision_hrms
DB_USER=vision_hrms_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
# For quick local experiments only: DB_ENGINE=sqlite

# --- Files ---------------------------------------------------------------------
# Private uploads (documents, CCTV evidence, import files). Must NOT be under any web-served directory.
PRIVATE_MEDIA_ROOT=/var/lib/vision_hrms/private
MAX_UPLOAD_BYTES=5242880
MAX_IMPORT_BYTES=10485760

# --- Email (Microsoft 365 / Google Workspace / company SMTP) --------------------
# Microsoft 365: EMAIL_HOST=smtp.office365.com  EMAIL_PORT=587  EMAIL_USE_TLS=true (SMTP AUTH must be enabled for the mailbox)
# Google Workspace: EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587  EMAIL_USE_TLS=true (use an app password or SMTP relay)
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HR Portal <hr-portal@your-company.example>
EMAIL_MAX_ATTEMPTS=5

# --- Security ------------------------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
SESSION_IDLE_TIMEOUT_SECONDS=1800
PASSWORD_RESET_TIMEOUT=3600
SECURE_SSL_REDIRECT=true

# --- Background tasks & cache (optional) ---------------------------------------
# Without Celery, emails are sent inline after each transaction commits and retries
# run via `python manage.py process_notifications` from cron.
USE_CELERY=false
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Strongly recommended in production so login throttling is shared across Gunicorn workers:
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
